{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Minimal non-PII user account root document anchoring private data and workspaces.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "accountType": {
          "type": "string",
          "enum": ["standard"],
          "maxLength": 32,
          "description": "Fixed non-privileged account tier assigned on registration."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "accountType", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Strictly private user profile containing PII (email, displayName, photoURL).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "User display name from Google Sign-In."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified email address of the user."
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Avatar photo URL from Google Sign-In."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-login/update timestamp."
        }
      },
      "required": ["uid", "ownerId", "displayName", "email", "photoURL", "createdAt", "updatedAt"]
    },
    "AppConfigDoc": {
      "title": "AppConfigDoc",
      "description": "Native Firestore Map container storing SalesPro targets, master store settings, weekly BA configs, KPIs, and Google Sheet integration settings.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching the authenticated user."
        },
        "configKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier matching the configuration slice key."
        },
        "payload": {
          "type": "object",
          "description": "Native Firestore map wrapping the structured configuration data (never JSON.stringify)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": ["ownerId", "configKey", "payload", "createdAt", "updatedAt"]
    },
    "TransactionDoc": {
      "title": "TransactionDoc",
      "description": "Individual sales/sell-out/return transaction record entered manually or synced individually.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching the authenticated user."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique transaction document identifier."
        },
        "TANGGAL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Transaction date string."
        },
        "BULAN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Month name (e.g. OKTOBER)."
        },
        "TAHUN": {
          "type": "number",
          "description": "Transaction calendar year."
        },
        "BA": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Beauty Advisor name."
        },
        "BA_Number": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "Beauty Advisor employee code."
        },
        "COVER_AREA": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Coverage area label."
        },
        "SALES": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Assigned Sales representative name."
        },
        "SPV": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Assigned Supervisor name."
        },
        "BRAND": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Cosmetic brand name."
        },
        "NO_SKU": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "SKU code."
        },
        "SPU": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Short product unit name."
        },
        "SKU": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Full product SKU description."
        },
        "PRODUK_FOCUS": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Focus product classification."
        },
        "PRODUK_NEW": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "New or existing product flag."
        },
        "NAMA_STORE": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Retail store name."
        },
        "REGION": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Region/city name."
        },
        "KATEGORI": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Product category."
        },
        "QTY": {
          "type": "number",
          "description": "Quantity sold or returned."
        },
        "VALUE": {
          "type": "number",
          "description": "Transaction value in IDR."
        },
        "KET": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Transaction type (SELL IN, SELL OUT, RETURN)."
        },
        "weekNumber": {
          "type": "number",
          "description": "Optional ISO week number."
        },
        "STATUS_PRODUK": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Optional product lifecycle status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "ownerId",
        "id",
        "TANGGAL",
        "BULAN",
        "TAHUN",
        "BA",
        "BA_Number",
        "COVER_AREA",
        "SALES",
        "SPV",
        "BRAND",
        "NO_SKU",
        "SPU",
        "SKU",
        "PRODUK_FOCUS",
        "PRODUK_NEW",
        "NAMA_STORE",
        "REGION",
        "KATEGORI",
        "QTY",
        "VALUE",
        "KET",
        "createdAt",
        "updatedAt"
      ]
    },
    "TransactionBatchDoc": {
      "title": "TransactionBatchDoc",
      "description": "Chunked batch of up to 250 native transaction maps synced from Google Sheets or CSV imports.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching the authenticated user."
        },
        "batchIndex": {
          "type": "number",
          "description": "Zero-based batch index."
        },
        "totalBatches": {
          "type": "number",
          "description": "Total batch count in this dataset snapshot."
        },
        "datasetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Snapshot version identifier tying batches together."
        },
        "records": {
          "type": "array",
          "description": "Bounded list (max 250 items) of native TransactionRecord maps."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "batchIndex", "totalBatches", "datasetVersion", "records", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Minimal non-PII user account root document."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private PII document (`profile`) strictly readable/writable by the owning user."
    },
    "/users/{userId}/configs/{configId}": {
      "schema": { "$ref": "#/entities/AppConfigDoc" },
      "description": "Persisted SalesPro configurations, targets, master data, KPI overrides, and GAS settings."
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/TransactionDoc" },
      "description": "Individual transaction records created or updated by the user."
    },
    "/users/{userId}/transactionBatches/{batchId}": {
      "schema": { "$ref": "#/entities/TransactionBatchDoc" },
      "description": "Chunked Google Sheet / CSV transaction dataset batches owned by the user."
    }
  }
}
